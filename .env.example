# Rachel9 Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID (send /start to @userinfobot to find it)
OWNER_TELEGRAM_USER_ID=

# Path to shared folder for persistent data (database, files, etc.)
SHARED_FOLDER_PATH=

# Environment (development | production | test)
NODE_ENV=production

# Log level (debug | info | warn | error)
LOG_LEVEL=info

# Prem API key (from dashboard.prem.io)
PREM_API_KEY=

# Optional: override the Prem model
# PREM_MODEL=deepseek-v4.1-flash-1017

# Thinking effort (minimal/low map to DeepSeek low; medium/high to high): dynamic | minimal | low | medium | high
THINKING_LEVEL=dynamic

# Optional voice/audio transcription (Groq Whisper)
GROQ_API_KEY=
STT_PROVIDER=groq
